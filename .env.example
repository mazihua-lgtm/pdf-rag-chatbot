# ============================================
# pdf-rag-chatbot · .env 示例
# 复制本文件为 .env 并填入真实 key
# ============================================

# === 必填：Claude 生成答案 ===
# 从 https://console.anthropic.com/ 获取
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Claude 模型（默认 claude-3-5-sonnet-latest，生产建议 claude-3-5-sonnet-20241022 锁版本）
CLAUDE_MODEL=claude-3-5-sonnet-latest

# === 嵌入方案（任选其一，默认本地无 key） ===

# 本地嵌入（默认，无需 API key，首次会下载 ~120MB 模型）
# 不需要任何环境变量

# 备选 A：Voyage AI（Anthropic 官方推荐，强烈建议搭配 Claude）
# VOYAGE_API_KEY=pa-xxxxx
# VOYAGE_MODEL=voyage-3

# 备选 B：OpenAI
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_EMBED_MODEL=text-embedding-3-small

# === 向量库 ===
# Chroma 持久化目录（相对路径，默认即可）
CHROMA_PERSIST_DIR=./chroma_db

# Collection 名称
CHROMA_COLLECTION=pdf_rag_chinese

# === 检索参数 ===
# 召回段落数（k），按需调整
RETRIEVAL_K=4

# === PDF 解析 ===
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# === 测试 ===
# 是否运行需要 API key 的端到端测试，默认 false
RUN_LIVE_TEST=0
